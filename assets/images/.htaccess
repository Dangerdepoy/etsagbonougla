# Désactive toute exécution de script dans le dossier d'images public
<FilesMatch "\.(php|php\d*|phtml|phar|pl|py|cgi|sh|htaccess)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order Deny,Allow
    Deny from all
  </IfModule>
</FilesMatch>
Options -Indexes -ExecCGI
