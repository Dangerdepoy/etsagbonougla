# =============================================================================
# ETS AGBONOUGLA — Configuration Environnement Serveur (Phase 2 CRM / CMS)
# Copiez ce fichier en `.env` sur le serveur de production (LWS / VPS)
# Ne commitez jamais le fichier `.env` contenant les vrais secrets.
# =============================================================================

APP_ENV=production
APP_URL=https://etsagbonougla.net
DAILY_HASH_SALT=remplacer_par_une_chaine_aleatoire_de_64_caracteres

# --- Base de données (SQLite par défaut en local, MySQL recommandé sur LWS) ---
DB_DRIVER=sqlite
DB_SQLITE_PATH=database/ets_agbonougla.sqlite

# Décommentez pour MySQL (LWS cPanel) :
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=etsagb_crm_cms
# DB_USER=etsagb_user
# DB_PASS=votre_mot_de_passe_mysql_robuste

# --- Compte Administrateur Initial (Créé uniquement via seed sécurisé) ---
ADMIN_INITIAL_EMAIL=direction@etsagbonougla.net
# Générer un hash Argon2id avec : php -r "echo password_hash('VotreMotDePasse', PASSWORD_ARGON2ID);"
ADMIN_INITIAL_PASSWORD_HASH=
ADMIN_TOTP_SECRET=JBSWY3DPEHPK3PXP
ADMIN_ALLOWLIST_IPS=

# --- Notifications Email & SMTP (Réception des demandes de devis) ---
NOTIFY_ADMIN_EMAILS=info@etsagbonougla.net,direction@etsagbonougla.net
SMTP_ENABLED=false
SMTP_HOST=mail.etsagbonougla.net
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USER=info@etsagbonougla.net
SMTP_PASS=
SMTP_FROM_NAME="ETS AGBONOUGLA — Devis & CRM"

# --- Signature Développeur ---
LAMANO_DESIGN_URL=https://lamanodesign.com
