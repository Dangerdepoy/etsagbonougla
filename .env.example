# =============================================================================
# ETS AGBONOUGLA — Configuration Sécurité & Environnement Serveur (Production)
# Toute modification d'identifiant, de mot de passe ou de double authentification
# (Google Authenticator) s'effectue EXCLUSIVEMENT dans ce fichier .env.
# =============================================================================

APP_ENV=production
APP_URL=https://etsagbonougla.net
DAILY_HASH_SALT=ets_agbonougla_pk26_sec_salt_9f8e7d6c5b4a3f2e1d0c

# --- Base de données (SQLite par défaut, MySQL optionnel sur LWS) ---
DB_DRIVER=sqlite
DB_SQLITE_PATH=database/ets_agbonougla.sqlite

# Décommentez pour MySQL (LWS cPanel) :
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=etsagb_crm_cms
# DB_USER=etsagb_user
# DB_PASS=votre_mot_de_passe_mysql_robuste

# =============================================================================
# ACCÈS ADMINISTRATEUR & DOUBLE AUTHENTIFICATION (GOOGLE AUTHENTICATOR)
# =============================================================================
# Identifiant de connexion :
ADMIN_INITIAL_EMAIL=direction@etsagbonougla.net

# Mot de passe administrateur (vous pouvez saisir un mot de passe en clair dans ADMIN_PASSWORD
# ou un hash Argon2id/Bcrypt dans ADMIN_INITIAL_PASSWORD_HASH) :
ADMIN_PASSWORD=EtsAgbonougla2026!
ADMIN_INITIAL_PASSWORD_HASH=

# Double Authentification TOTP (Google Authenticator - RFC 6238) :
ADMIN_TOTP_ENABLED=true
ADMIN_TOTP_SECRET=JBSWY3DPEHPK3PXP

# Affichage à usage unique du QR Code Google Authenticator :
# - Mettez `true` pour afficher le QR Code sur la page de connexion (1 seule fois).
# - Dès la première connexion réussie avec le code à 6 chiffres, cette valeur
#   passe automatiquement à `false` et le QR Code disparaît définitivement.
# - En cas de perte de votre téléphone, remettez `true` ici depuis votre IDE / LWS.
ADMIN_SHOW_2FA_QR_ONCE=true

# --- Signature Développeur ---
LAMANO_DESIGN_URL=https://lamanodesign.com
NOTIFY_ADMIN_EMAILS=contact@ets-agbonougla.ci
