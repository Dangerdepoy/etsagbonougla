# =============================================================================
# ETS AGBONOUGLA — Configuration Apache & Sécurité Production (LWS / VPS)
# Design & Développement : LAMANO DESIGN
# =============================================================================

# 1. ENCODAGE PAR DÉFAUT
AddDefaultCharset UTF-8
DefaultLanguage fr-FR

# 2. BLOCAGE STRICT DES FICHIERS & DOSSIERS SENSIBLES
<FilesMatch "^(\.env|\.git|\.htaccess|\.htpasswd|composer\.(json|lock)|.*\.sqlite|.*\.sql|.*\.log|.*\.bak|.*\.sh)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order Deny,Allow
    Deny from all
  </IfModule>
</FilesMatch>

# Interdit l'exploration des dossiers sans index
Options -Indexes

# 3. EN-TÊTES DE SÉCURITÉ HTTP
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-XSS-Protection "1; mode=block"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# 4. COMPRESSION MOD_DEFLATE (VITESSE & CORE WEB VITALS)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/xml image/svg+xml
</IfModule>

# 5. MISE EN CACHE DES ASSETS STATIQUES (MOD_EXPIRES)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  
  # HTML & API : Revalidation immédiate
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  
  # CSS & JavaScript (avec gestion de version ?v=X)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  
  # Images & Médias
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  
  # Polices
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

# 6. RÉÉCRITURE D'URL & REDIRECTION HTTPS (SI DISPONIBLE)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirection automatique vers HTTPS en production (LWS cPanel)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP_HOST} ^(www\.)?etsagbonougla\.net$ [NC]
  RewriteRule ^(.*)$ https://etsagbonougla.net/$1 [R=301,L]

  # Empêche l'accès direct aux dossiers de base de données et scratch
  RewriteRule ^database/ - [F,L]
  RewriteRule ^scratch/ - [F,L]
</IfModule>
